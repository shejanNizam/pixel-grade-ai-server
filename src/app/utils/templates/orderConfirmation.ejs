<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Order Confirmation - PixelGrade</title>
  <style>
    body {
      font-family: 'Segoe UI', Arial, sans-serif;
      background-color: #09090b;
      color: #f4f4f5;
      margin: 0;
      padding: 0;
    }
    .container {
      max-width: 600px;
      margin: 30px auto;
      background: #111113;
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 16px;
      overflow: hidden;
    }
    .header {
      background: linear-gradient(135deg, #4c1d95, #1e1b4b);
      padding: 30px 20px;
      text-align: center;
    }
    .header h1 {
      color: #ffffff;
      margin: 0;
      font-size: 24px;
      font-weight: 700;
    }
    .header p {
      color: #c4b5fd;
      margin: 6px 0 0;
      font-size: 13px;
    }
    .content {
      padding: 24px;
    }
    .order-box {
      background: #18181b;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 12px;
      padding: 16px;
      margin-bottom: 20px;
    }
    .tracking-badge {
      background: rgba(59, 130, 246, 0.15);
      border: 1px solid rgba(59, 130, 246, 0.4);
      border-radius: 8px;
      padding: 14px;
      margin: 18px 0;
      text-align: center;
    }
    .tracking-num {
      font-family: monospace;
      font-size: 16px;
      color: #60a5fa;
      font-weight: bold;
      letter-spacing: 1px;
    }
    .btn-track {
      display: inline-block;
      margin-top: 10px;
      background: #7c3aed;
      color: #ffffff !important;
      text-decoration: none;
      padding: 10px 20px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: 600;
    }
    .table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 12px;
      font-size: 13px;
    }
    .table td {
      padding: 8px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }
    .total-row td {
      border-top: 1px solid rgba(255, 255, 255, 0.15);
      font-weight: bold;
      font-size: 15px;
      color: #fbbf24;
    }
    .footer {
      text-align: center;
      padding: 20px;
      font-size: 11px;
      color: #71717a;
      border-top: 1px solid rgba(255, 255, 255, 0.05);
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>PixelGrade</h1>
      <p>Order &amp; Shipping Confirmation</p>
    </div>
    <div class="content">
      <p>Hi <%= name %>,</p>
      <p>Thank you for your purchase! Your order has been received.</p>
      
      <% if (trackingNumber) { %>
      <div class="tracking-badge">
        <div style="font-size: 12px; color: #93c5fd; margin-bottom: 4px;">USPS Tracking Number:</div>
        <div class="tracking-num"><%= trackingNumber %></div>
        <a href="https://tools.usps.com/go/TrackConfirmAction?tLabels=<%= trackingNumber %>" target="_blank" class="btn-track">Track Package on USPS.com</a>
      </div>
      <% } %>

      <div class="order-box">
        <h3 style="margin: 0 0 10px; font-size: 14px; color: #a78bfa;">Order Summary (<%= orderId.startsWith('#') ? orderId : '#' + orderId.slice(-8).toUpperCase() %>)</h3>
        <table class="table">
          <tr>
            <td>Physical Acrylic Slab Holder (Qty: <%= quantity %>)</td>
            <td style="text-align: right;">$<%= subtotal %></td>
          </tr>
          <tr>
            <td>USPS Standard Shipping</td>
            <td style="text-align: right;">$<%= shippingFee %></td>
          </tr>
          <tr>
            <td>Estimated Sales Tax (8%)</td>
            <td style="text-align: right;">$<%= taxAmount %></td>
          </tr>
          <tr class="total-row">
            <td>Total Paid</td>
            <td style="text-align: right;">$<%= totalAmount %> USD</td>
          </tr>
        </table>
      </div>

      <div class="order-box">
        <h3 style="margin: 0 0 10px; font-size: 14px; color: #a78bfa;">Shipping Address</h3>
        <p style="margin: 0; font-size: 13px; line-height: 1.5; color: #e4e4e7;">
          <strong><%= shippingAddress.fullName %></strong><br>
          <%= shippingAddress.streetAddress %><br>
          <%= shippingAddress.city %><% if (shippingAddress.state) { %>, <%= shippingAddress.state %><% } %> <%= shippingAddress.postalCode %><br>
          <%= shippingAddress.country %><br>
          Phone: <%= shippingAddress.phone %>
        </p>
      </div>
    </div>
    <div class="footer">
      &copy; 2026 PixelGrade. All rights reserved.
    </div>
  </div>
</body>
</html>
