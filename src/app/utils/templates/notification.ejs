<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        font-family: 'Segoe UI', Arial, sans-serif;
        background-color: #f4f2fb;
        color: #333;
        padding: 40px 20px;
      }
      .wrapper {
        max-width: 560px;
        margin: 0 auto;
      }
      .header {
        background: linear-gradient(135deg, #7c5cff 0%, #5b34d9 100%);
        border-radius: 10px 10px 0 0;
        padding: 32px 40px;
        text-align: center;
      }
      .header h1 {
        color: #ffffff;
        font-size: 20px;
        font-weight: 600;
      }
      .body {
        background: #ffffff;
        border-radius: 0 0 10px 10px;
        padding: 36px 40px;
      }
      .body h2 {
        font-size: 17px;
        color: #1d1d24;
        margin-bottom: 12px;
      }
      .body p {
        font-size: 14px;
        line-height: 1.6;
        color: #55555f;
      }
      .cta {
        display: inline-block;
        margin-top: 24px;
        background: #7c5cff;
        color: #ffffff !important;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        padding: 12px 28px;
        border-radius: 8px;
      }
      .footer {
        text-align: center;
        font-size: 12px;
        color: #9a97a8;
        margin-top: 24px;
        line-height: 1.6;
      }
      .footer a {
        color: #7c5cff;
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="header">
        <h1>PixelGrade AI</h1>
      </div>
      <div class="body">
        <h2><%= title %></h2>
        <% if (body) { %>
        <p><%= body %></p>
        <% } %>
        <a class="cta" href="<%= dashboardUrl %>">Open your dashboard</a>
      </div>
      <div class="footer">
        You are receiving this because email alerts are enabled in your
        notification settings.<br />
        Manage preferences from your dashboard at any time.
      </div>
    </div>
  </body>
</html>
