option_settings:
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
    NPM_CONFIG_OMIT: dev
    PORT: 5000
  aws:elasticbeanstalk:command:
    # server.zip ships node_modules pre-installed, so a deploy is an unpack and
    # a restart. The headroom is for the case where EB still decides to run
    # `npm ci` on the instance: this tree pulls sharp and bcrypt, and at 300 it
    # timed out on one of two instances on 2026-08-31 and reverted the whole
    # environment. Was 1800 when this environment last deployed cleanly.
    Timeout: 1800
