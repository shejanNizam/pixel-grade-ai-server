# Fonts for the slab label band.
#
# The band's text layer is an SVG rasterised by sharp -> librsvg -> pango,
# which resolves font-family through fontconfig against fonts installed on the
# host. With none installed pango draws an empty hexbox per glyph: the
# composite still succeeds and the request still returns 200, so the first
# report of the problem is somebody looking at a printed label.
# `warnIfFontsMissing` in slab.fonts.ts logs this at boot.
#
# ⚠️ Declared as `packages:` and NOT as a `commands:` shell running dnf.
# EB commands run as root on every deploy, and `dnf` waits indefinitely for
# the RPM transaction lock when cloud-init or another dnf holds it. That is a
# hang, not an error, so `ignoreErrors: true` cannot rescue it — the deploy
# sits until the command timeout expires and EB reverts the environment. It is
# a per-instance race, which is what a deploy where one instance completes and
# the other times out looks like (2026-08-31, i-08c9746d9f4fce85).
#
# This was already the working form; commit afdd022 ("slab lebel design
# updated") reverted it to the dnf command by accident. Do not change it back.
packages:
  yum:
    fontconfig: []
    dejavu-sans-fonts: []
    liberation-sans-fonts: []
    google-noto-sans-cjk-ttc-fonts: []
    google-noto-sans-jp-fonts: []

