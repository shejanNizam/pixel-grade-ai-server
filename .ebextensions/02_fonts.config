# Fonts for slab label rendering.
#
# The band's text is an SVG <text> layer that sharp rasterises through
# librsvg -> pango, which resolves `font-family` against fonts installed on the
# instance via fontconfig. Amazon Linux 2023 ships none, so with fontconfig
# present but no font files behind it pango draws an empty hexbox for every
# glyph — the card name, grade and Pixel ID print as rows of boxes.
#
# Each package is installed on its own line on purpose. `dnf install -y a b c`
# is a single transaction, so one unavailable package name takes the whole set
# down with it; the previous version of this file paired that with `|| true`
# and `ignoreErrors`, which is how the instance ended up with fontconfig
# installed and not a single font.
container_commands:
  01_fontconfig:
    command: dnf install -y fontconfig

  02_font_files:
    command: |
      for pkg in dejavu-sans-fonts dejavu-serif-fonts \
                 liberation-sans-fonts liberation-serif-fonts \
                 google-noto-sans-fonts; do
        dnf install -y "$pkg" || echo "font package unavailable, skipping: $pkg"
      done

  03_font_cache:
    command: fc-cache -f

  # Fail the deploy rather than ship a build that prints boxes where the grade
  # and Pixel ID belong. This check is the point of the file: the failure is
  # otherwise completely silent — the slab still renders, health stays green,
  # and nobody finds out until someone looks at a label.
  04_verify:
    command: |
      if ! fc-list | grep -qiE 'dejavu|liberation|noto'; then
        echo "FATAL: no usable font on this instance — slab labels would render as boxes" >&2
        exit 1
      fi
      echo "fonts available:"
      fc-list : family | tr ',' '\n' | sort -u | head -20
