PORT=5000
DATABASE_URL=mongodb://localhost:27017/your-db-name

NODE_ENV=development
# NODE_ENV=production

# JWT
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars
JWT_ACCESS_EXPIRES=1d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES=30d
JWT_RESET_SECRET=your_jwt_reset_secret_min_32_chars

# BCRYPT
BCRYPT_SALT_ROUND=10

# SUPER ADMIN and ADMIN
SUPER_ADMIN_EMAIL=super_admin@example.com
SUPER_ADMIN_PASSWORD=SuperAdmin@2025!
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@Secure2025!

# GOOGLE OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Express Session
EXPRESS_SESSION_SECRET=your_express_session_secret

# Frontend URL — comma-separated list of allowed CORS origins.
# Use * to allow all origins in development.
FRONTEND_URL=http://localhost:3000,https://your-tunnel.example.com
# Canonical frontend URL for redirects, email links, OAuth returns, and Stripe
# success/cancel pages. Independent of the CORS list — set it to your live site
# so payment redirects land there, not on localhost. Falls back to the first
# FRONTEND_URL entry if unset.
FRONTEND_PUBLIC_URL=https://your-frontend.example.com

# Stripe (optional)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP — Simple Mail Transfer Protocol (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=your_email@gmail.com

# Redis (optional — required for OTP, Socket.io scaling, caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password

# Scrydex — card identification + market pricing (optional until credentials exist)
# BOTH key and team id are required together; one without the other returns 401
SCRYDEX_API_KEY=your_scrydex_api_key
SCRYDEX_TEAM_ID=your_scrydex_team_id
SCRYDEX_BASE_URL=https://api.scrydex.com
# Dev-only: fabricate identification + pricing (needs NODE_ENV=development).
# Turn OFF the moment real Scrydex credentials are in place.
MOCK_SCRYDEX=false

# OpenAI — AI grading (optional until credentials exist)
OPENAI_API_KEY=sk-your_openai_api_key
# Confirm against OpenAI's current vision model list before launch
# Pin a DATED snapshot, not an alias — aliases repoint silently and break
# the same-image-same-grade guarantee without a GRADING_MODEL_VERSION bump
OPENAI_GRADING_MODEL=gpt-5.5-2026-04-23
# Stamped onto every report AND part of the grading cache key.
# Bump when the model or prompt changes so old grades stay as issued.
GRADING_MODEL_VERSION=pixelgrade-v1

# Pricing source (scrydex covers it on the same credentials)
PRICING_SOURCE=scrydex

# Slab background generation — vendor pending client approval (OpenAI proposed)
IMAGEGEN_API_KEY=your_imagegen_api_key
IMAGEGEN_BASE_URL=
