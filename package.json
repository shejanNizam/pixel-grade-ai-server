  "description": "Pixel Grade AI backend — Express + MongoDB + TypeScript API with auth, OTP, Redis, Socket.io, and Cloudinary",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && node scripts/copy-email-templates.mjs",
    "lint": "npx eslint ./src",
    "dev": "tsx watch src/server.ts",
    "dev:local": "tsx watch --env-file=.env src/server.ts",
