    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "backend",
    "typescript",
    "nodejs",
    "express",
    "mongodb",
    "mongoose",
    "redis",
    "socket.io",
    "pixel-grade-ai"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
